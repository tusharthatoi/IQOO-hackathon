# CELL 3: Robust Dataset Path Auto-Discovery
from pathlib import Path
import os

print("Scanning for dataset directory...")

input_base = Path("/kaggle/input")
dataset_root = None

# 1. Print everything mounted in /kaggle/input for visibility
if input_base.exists():
    print(f"Mounted in /kaggle/input: {[p.name for p in input_base.iterdir()]}")
    
    # Search recursively for the directory containing the food class folders
    # A food class directory contains image files (.jpg, .jpeg, .png)
    for root, dirs, files in os.walk(input_base):
        # Ignore hidden folders
        subdirs = [d for d in dirs if not d.startswith(".")]
        # If a directory has 50+ subdirectories, it's the class root
        if len(subdirs) >= 40:
            dataset_root = Path(root)
            print(f"-> Found {len(subdirs)} class folders directly in: {dataset_root}")
            break
        
        # Or check if subdirs contain images directly
        if len(subdirs) >= 10:
            sample_sub = Path(root) / subdirs[0]
            if sample_sub.is_dir():
                imgs = [f for f in sample_sub.iterdir() if f.suffix.lower() in {'.jpg', '.jpeg', '.png', '.webp'}]
                if len(imgs) > 0:
                    dataset_root = Path(root)
                    print(f"-> Found class root with images in: {dataset_root}")
                    break

# 2. Local fallback check if not running on Kaggle
if dataset_root is None:
    for local_cand in ["dataset", "data/dataset", "../input"]:
        p = Path(local_cand)
        if p.exists() and p.is_dir():
            subdirs = [d for d in p.iterdir() if d.is_dir() and not d.name.startswith(".")]
            if len(subdirs) >= 10:
                dataset_root = p
                break

if dataset_root is None:
    raise FileNotFoundError(
        f"\nCould not automatically locate the food classes folder inside /kaggle/input.\n"
        f"Available contents in /kaggle/input: {list(input_base.iterdir()) if input_base.exists() else 'None'}"
    )

print("=" * 60)
print(f"SUCCESS: Active Dataset Directory Set To:\n{dataset_root.resolve()}")
print("=" * 60)



# CELL 4: Read-Only Dataset Audit
from PIL import Image

VALID_EXTS = {'.jpg', '.jpeg', '.png', '.webp', '.bmp'}
class_dirs = sorted([d for d in dataset_root.iterdir() if d.is_dir() and not d.name.startswith('.')])

valid_images_map = {}
insufficient_classes = []

print(f'Auditing {len(class_dirs)} discovered class directories...')
for c_dir in class_dirs:
    c_name = c_dir.name
    imgs = sorted([f for f in c_dir.iterdir() if f.is_file() and f.suffix.lower() in VALID_EXTS])
    valid_for_class = []
    for img_p in imgs:
        try:
            with Image.open(img_p) as img:
                img.verify()
            valid_for_class.append(img_p)
        except Exception:
            pass
    valid_images_map[c_name] = valid_for_class
    if len(valid_for_class) < CONFIG['min_images_per_class']:
        insufficient_classes.append((c_name, len(valid_for_class)))

print(f'Total Classes Discovered: {len(valid_images_map)}')
total_valid_imgs = sum(len(v) for v in valid_images_map.values())
print(f'Total Valid Images      : {total_valid_imgs}')

if insufficient_classes:
    print('\n! ERROR: Classes with < 50 valid images !')
    for c_name, count in insufficient_classes:
        print(f'  - {c_name}: {count} images')
    raise ValueError('All classes must contain >= 50 valid images for deterministic split.')
else:
    print('Dataset Audit Status    : PASSED (All classes have >= 50 valid images)')


# CELL 5: Deterministic 35/5/10 Split & Manifest Generation
import pandas as pd

manifest_dir = Path('data')
manifest_dir.mkdir(parents=True, exist_ok=True)

train_records, val_records, test_records = [], [], []
verification_lines = ['DETERMINISTIC SPLIT VERIFICATION REPORT', '=' * 60]

sorted_classes = sorted(valid_images_map.keys())
class_to_id = {name: idx for idx, name in enumerate(sorted_classes)}

for cls_name in sorted_classes:
    imgs = valid_images_map[cls_name]
    cid = class_to_id[cls_name]
    c_train = imgs[0:35]
    c_val = imgs[35:40]
    c_test = imgs[40:50]
    
    for p in c_train:
        train_records.append({'filepath': str(p.resolve()), 'class_id': cid, 'class_name': cls_name, 'split': 'train'})
    for p in c_val:
        val_records.append({'filepath': str(p.resolve()), 'class_id': cid, 'class_name': cls_name, 'split': 'val'})
    for p in c_test:
        test_records.append({'filepath': str(p.resolve()), 'class_id': cid, 'class_name': cls_name, 'split': 'test'})
    
    verification_lines.append(f'Class {cid:02d} [{cls_name}]: 35 Train, 5 Val, 10 Test (First test: {c_test[0].name})')

train_df = pd.DataFrame(train_records)
val_df = pd.DataFrame(val_records)
test_df = pd.DataFrame(test_records)

train_df.to_csv(manifest_dir / 'train_manifest.csv', index=False)
val_df.to_csv(manifest_dir / 'val_manifest.csv', index=False)
test_df.to_csv(manifest_dir / 'test_manifest.csv', index=False)

with open(manifest_dir / 'split_verification.txt', 'w') as f:
    f.write('\n'.join(verification_lines) + '\n')

print(f'Train Samples : {len(train_df)} (35 per class)')
print(f'Val Samples   : {len(val_df)} (5 per class)')
print(f'Test Samples  : {len(test_df)} (10 per class - SACRED UNTOUCHED)')


# CELL 6: tf.data Pipeline Construction (Optimal RAM Caching & Vectorized Augmentation)
def create_dataset(manifest, batch_size=32, is_training=False):
    filepaths = manifest['filepath'].values
    labels = manifest['class_id'].values
    ds = tf.data.Dataset.from_tensor_slices((filepaths, labels))
    
    def _load(path, label):
        raw = tf.io.read_file(path)
        img = tf.io.decode_image(raw, channels=3, expand_animations=False)
        img = tf.image.resize(img, CONFIG['image_size'])
        img = (tf.cast(img, tf.float32) / 127.5) - 1.0  # Normalizes to [-1.0, 1.0]
        return img, tf.cast(label, tf.int32)
    
    # 1. Parallel decode and resize
    ds = ds.map(_load, num_parallel_calls=tf.data.AUTOTUNE)
    
    # 2. In-memory caching: eliminates disk I/O bottlenecks after Epoch 1
    ds = ds.cache()
    
    if is_training:
        # 3. Post-cache shuffle: unique epoch ordering without disk penalties
        ds = ds.shuffle(buffer_size=min(len(filepaths), 1000), seed=CONFIG['seed'])
        # 4. Batch before augmentation for vectorized GPU execution
        ds = ds.batch(batch_size)
        aug = tf.keras.Sequential([
            tf.keras.layers.RandomFlip('horizontal'),
            tf.keras.layers.RandomRotation(0.08),
            tf.keras.layers.RandomZoom((-0.1, 0.1))
        ])
        ds = ds.map(lambda x, y: (aug(x, training=True), y), num_parallel_calls=tf.data.AUTOTUNE)
    else:
        ds = ds.batch(batch_size)
    
    # 5. Prefetch to overlap data preparation with GPU compute
    return ds.prefetch(tf.data.AUTOTUNE)

train_ds = create_dataset(train_df, batch_size=CONFIG['batch_size'], is_training=True)
val_ds = create_dataset(val_df, batch_size=CONFIG['batch_size'], is_training=False)
print('tf.data pipelines successfully created with in-memory caching and prefetching.')



# CELL 7: Model Architecture Factory (Corrected Input Normalization)
from tensorflow.keras import layers, models
import tensorflow as tf

num_classes = len(sorted_classes)
active_backbone_name = 'mobilenet_v3_small'

print(f"Building {active_backbone_name.upper()} with normalized [-1, 1] input compatibility...")

# include_preprocessing=False tells MobileNetV3 NOT to rescale a second time!
base_model = tf.keras.applications.MobileNetV3Small(
    input_shape=(*CONFIG['image_size'], 3),
    include_top=False,
    weights='imagenet',
    include_preprocessing=False  # <-- CRITICAL FIX: Accepts [-1, 1] from Cell 6
)
base_model.trainable = False

inputs = layers.Input(shape=(*CONFIG['image_size'], 3), name="image_input")
x = base_model(inputs, training=False)
x = layers.GlobalAveragePooling2D(name="avg_pool")(x)
x = layers.BatchNormalization()(x)
x = layers.Dropout(0.3, name="dropout")(x)
outputs = layers.Dense(num_classes, activation='softmax', name="food_predictions")(x)

food_model = models.Model(inputs, outputs, name="IndianFood_MobileNetV3Small")
print("SUCCESS: MobileNetV3-Small initialized with frozen backbone and un-corrupted input scaling.")



# CELL 8: Stage 1: Transfer Learning (Frozen Backbone)
from pathlib import Path
Path('training').mkdir(parents=True, exist_ok=True)

food_model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=CONFIG['stage1_lr']),
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

callbacks = [
    tf.keras.callbacks.ModelCheckpoint('training/best_weights.weights.h5', save_best_only=True, save_weights_only=True, monitor='val_loss'),
    tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=3, restore_best_weights=True),
    tf.keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.2, patience=2, min_lr=1e-6)
]

print('Starting Stage 1 training...')
history_s1 = food_model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=CONFIG['stage1_epochs'],
    callbacks=callbacks
)


# CELL 9: Extended Fine-Tuning (Stage 2 - 50 Max Epochs)
import tensorflow as tf

print("=" * 70)
print("STAGE 2: UNFREEZING CONVOLUTIONAL LAYERS FOR INDIAN FOOD SPECIALIZATION")
print("=" * 70)

# 1. Unfreeze the base model
base_model.trainable = True

# Freeze bottom 50% of layers (generic edge/blob detectors)
# Fine-tune the top 50% layers (specialized shape/texture detectors)
num_layers = len(base_model.layers)
unfreeze_from = int(num_layers * 0.5)

for layer in base_model.layers[:unfreeze_from]:
    layer.trainable = False
for layer in base_model.layers[unfreeze_from:]:
    # Keep BatchNormalization in inference mode to prevent statistic drift
    if isinstance(layer, tf.keras.layers.BatchNormalization):
        layer.trainable = False
    else:
        layer.trainable = True

print(f"Total backbone layers : {num_layers}")
print(f"Fine-tuning top layers: {num_layers - unfreeze_from} layers (Layers {unfreeze_from} to {num_layers})")

# 2. Compile with lower learning rate for delicate fine-tuning
STAGE2_MAX_EPOCHS = 50
food_model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-4),
    loss='sparse_categorical_crossentropy',
    metrics=['accuracy']
)

callbacks_s2 = [
    tf.keras.callbacks.ModelCheckpoint(
        'training/best_finetuned_weights.weights.h5',
        save_best_only=True,
        save_weights_only=True,
        monitor='val_accuracy',
        mode='max',
        verbose=1
    ),
    tf.keras.callbacks.EarlyStopping(
        monitor='val_accuracy',
        patience=8,
        restore_best_weights=True,
        verbose=1
    ),
    tf.keras.callbacks.ReduceLROnPlateau(
        monitor='val_loss',
        factor=0.3,
        patience=3,
        min_lr=1e-6,
        verbose=1
    )
]

print(f"\nStarting Stage 2 training (Up to {STAGE2_MAX_EPOCHS} epochs)...")
history_s2 = food_model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=STAGE2_MAX_EPOCHS,
    callbacks=callbacks_s2
)



# CELL 10: Evaluation on Sacred Untouched Test Set
import numpy as np
from sklearn.metrics import accuracy_score, classification_report, top_k_accuracy_score

test_ds = create_dataset(test_df, batch_size=CONFIG['batch_size'], is_training=False)
y_pred_probs = food_model.predict(test_ds)
y_true = test_df['class_id'].values
y_pred = np.argmax(y_pred_probs, axis=1)

top1 = accuracy_score(y_true, y_pred)
top3 = top_k_accuracy_score(y_true, y_pred_probs, k=3, labels=list(range(num_classes)))

print('=' * 60)
print(f'SACRED TEST SET EVALUATION ({len(test_df)} samples across {num_classes} classes)')
print('=' * 60)
print(f'Top-1 Accuracy : {top1 * 100:.2f}%')
print(f'Top-3 Accuracy : {top3 * 100:.2f}%')
print('=' * 60)
print(classification_report(y_true, y_pred, target_names=sorted_classes, zero_division=0))


