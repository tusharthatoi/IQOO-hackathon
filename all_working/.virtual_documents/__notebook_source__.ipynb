# CELL 2: Hyperparameter Configuration
from pathlib import Path

CONFIG = {
    'dataset_candidates': [
        '/kaggle/input/indian-food-images-dataset/Indian Food Images/Indian Food Images',
        '/kaggle/input/indian-food-images-dataset/Indian Food Images',
