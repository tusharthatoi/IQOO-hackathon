# CELL 12: FP32 TFLite Export
out_dir = Path('models')
out_dir.mkdir(parents=True, exist_ok=True)

converter = tf.lite.TFLiteConverter.from_keras_model(food_model)
tflite_fp32 = converter.convert()
fp32_path = out_dir / 'food_classifier_fp32.tflite'
with open(fp32_path, 'wb') as f:
    f.write(tflite_fp32)

print(f'Saved FP32 TFLite: {fp32_path} ({len(tflite_fp32) / (1024*1024):.2f} MB)')


# CELL 13: Quantized (Dynamic Range) TFLite Export
converter_quant = tf.lite.TFLiteConverter.from_keras_model(food_model)
converter_quant.optimizations = [tf.lite.Optimize.DEFAULT]
tflite_quant = converter_quant.convert()
quant_path = out_dir / 'food_classifier_quantized.tflite'
with open(quant_path, 'wb') as f:
    f.write(tflite_quant)

print(f'Saved Quantized TFLite: {quant_path} ({len(tflite_quant) / (1024*1024):.2f} MB)')


# CELL 14: TFLite Runtime Inference Verification
interpreter = tf.lite.Interpreter(model_path=str(fp32_path))
interpreter.allocate_tensors()
in_idx = interpreter.get_input_details()[0]['index']
out_idx = interpreter.get_output_details()[0]['index']

sample_row = test_df.iloc[0]
img_raw = Image.open(sample_row['filepath']).convert('RGB').resize(CONFIG['image_size'])
inp_arr = (np.asarray(img_raw, dtype=np.float32) / 127.5) - 1.0
inp_arr = np.expand_dims(inp_arr, axis=0)

interpreter.set_tensor(in_idx, inp_arr)
interpreter.invoke()
tflite_preds = interpreter.get_tensor(out_idx)[0]
top_idx = int(np.argmax(tflite_preds))

print(f'Sample Image   : {Path(sample_row["filepath"]).name}')
print(f'True Label     : {sample_row["class_name"]}')
print(f'TFLite Predicted: {sorted_classes[top_idx]} ({tflite_preds[top_idx]:.1%})')
print('TFLite standalone runtime verified successfully.')


# CELL 15: Model Size and Latency Benchmark Report
import time

latencies = []
for _ in range(50):
    t0 = time.perf_counter()
    interpreter.set_tensor(in_idx, inp_arr)
    interpreter.invoke()
    latencies.append((time.perf_counter() - t0) * 1000.0)

print('=' * 60)
print('TFLITE BENCHMARK (Kaggle Host Environment)')
print('=' * 60)
print(f'FP32 Model Size     : {len(tflite_fp32) / (1024*1024):.2f} MB')
print(f'Quantized Model Size: {len(tflite_quant) / (1024*1024):.2f} MB')
print(f'Average Host Latency: {np.mean(latencies):.2f} ms')
print(f'Median Host Latency : {np.median(latencies):.2f} ms')
print('=' * 60)


