<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. CameraX Fullscreen Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Real-time HUD Reticle Overlay -->
    <com.iqoo.wellness.app.ui.CameraOverlayView
        android:id="@+id/cameraOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Top Header Bar -->
    <LinearLayout
        android:id="@+id/topHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="42dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_leaf"
            android:contentDescription="iQOO Wellness" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iQOO Wellness"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan your food"
                android:textColor="#90A4AE"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="18dp"
            android:src="@drawable/ic_person"
            android:contentDescription="Profile" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- 4. Top Mode Pill Bar -->
    <LinearLayout
        android:id="@+id/modePillBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_mode_bar_container"
        app:layout_constraintTop_toBottomOf="@id/topHeaderBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="Auto"
            android:textColor="#CFD8DC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_mode_pill_inactive" />

        <TextView
            android:id="@+id/btnFood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="Food"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_mode_pill_active" />

        <TextView
            android:id="@+id/btnPosture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:text="Posture"
            android:textColor="#CFD8DC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_mode_pill_inactive" />
    </LinearLayout>

    <!-- 5. Top Result Card (Positioned directly beneath Mode Selector) -->
    <LinearLayout
        android:id="@+id/cardResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_result_card_not_food"
        app:layout_constraintTop_toBottomOf="@id/modePillBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Header Row: Thumbnail + Details Column -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Live Crop Thumbnail -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCropThumbnail"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp"
                android:background="#263238"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Details Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title & Confidence Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtResultTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Not Food"
                        android:textColor="#EF5350"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResultConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="96%"
                        android:textColor="#EF5350"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Explanation / Subtext Row -->
                <LinearLayout
                    android:id="@+id/layoutExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="3dp">

                    <ImageView
                        android:id="@+id/iconState"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_warning_circle"
                        android:contentDescription="Status" />

                    <TextView
                        android:id="@+id/txtResultSubtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This doesn't look like a food item.\nTry scanning a dish or meal."
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Nutrition Macros Row -->
                <TextView
                    android:id="@+id/txtResultMacros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="~412 kcal  •  Protein 18g  •  Carbs 52g  •  Fat 14g"
                    android:textColor="#2ECC71"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="3dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Container 1: Food Confirmation Buttons (State: FOOD_DETECTED) -->
        <LinearLayout
            android:id="@+id/containerFoodConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnConfirmFood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:text="✓ Yes, that's right"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_confirm" />

            <TextView
                android:id="@+id/btnChangeFood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:text="Change food"
                android:textColor="#CFD8DC"
                android:textSize="13sp"
                android:background="@drawable/bg_btn_secondary" />
        </LinearLayout>

        <!-- Container 2: Portion Selection Controls (State: FOOD_CONFIRMED) -->
        <LinearLayout
            android:id="@+id/containerPortionSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtPortionPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How much did you eat?"
                android:textColor="#90A4AE"
                android:textSize="12sp" />

            <!-- Presets Row: Small / Medium / Large OR [200g] [225g] [250g] -->
            <LinearLayout
                android:id="@+id/rowPortionPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/btnPresetSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="Small (125g)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_pill_preset_unselected" />

                <TextView
                    android:id="@+id/btnPresetMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:paddingVertical="6dp"
                    android:text="Medium (250g)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_preset_selected" />

                <TextView
                    android:id="@+id/btnPresetLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:paddingVertical="6dp"
                    android:text="Large (375g)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="@drawable/bg_pill_preset_unselected" />
            </LinearLayout>

            <!-- Exact Gram Stepper Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txtPortionGrams"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Portion: 250 g"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPortionMinus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stepper_button" />

                <TextView
                    android:id="@+id/btnPortionPlus"
                    android:layout_width="38dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_stepper_button" />
            </LinearLayout>

            <!-- Confirm Portion Button -->
            <TextView
                android:id="@+id/btnConfirmPortion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:paddingVertical="8dp"
                android:text="Confirm portion"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_confirm" />
        </LinearLayout>

        <!-- Container 3: Confirmed / Re-scan Action (State: PORTION_CONFIRMED) -->
        <LinearLayout
            android:id="@+id/containerConfirmedAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnScanNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="Scan next food"
                android:textColor="#CFD8DC"
                android:textSize="12sp"
                android:background="@drawable/bg_btn_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6. Minimal Bottom Floating Pill -->
    <LinearLayout
        android:id="@+id/bottomControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_bottom_pill">

            <TextView
                android:id="@+id/txtBottomHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point the camera at a food item"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBottomSubhint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold steady for best results"
                android:textColor="#90A4AE"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnGallery"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="14dp"
            android:padding="11dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/bg_circle_icon"
            android:contentDescription="Gallery" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
